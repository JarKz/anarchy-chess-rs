ChessPieceDefinition(
    short_name: "P",
    full_name: "Pawn",
    is_vip: false,
    movement_rules: [
        // Side attacks on white
        MovementRule(
            conditions: [
                Equal(
                    SelfColor,
                    Color(White)
                ),
                Not(IsEmpty(Square(Target))),
            ],
            on_obstruction: ObstructionBehavior(
                on_ally: [
                    Discard,
                ],
                on_enemy: [
                    Capture,
                    Stop,
                ],
                on_empty: [
                    Continue,
                ],
            ),
            on_capture: RemovePiece(Target),
            generators: [
                Vector(
                    direction: (
                        -1,
                        -1,
                    ),
                    max_distance: Times(1),
                ),
                Vector(
                    direction: (
                        1,
                        -1,
                    ),
                    max_distance: Times(1),
                ),
            ],
            actions: [
                MoveSelf,
            ],
        ),
        // Left en passant on white
        MovementRule(
            conditions: [
                Equal(
                    SelfColor,
                    Color(White)
                ),
                Equal(
                    State(White("en_passant_target_square")),
                    Square(OffsetFromOrigin((
                                -1,
                                -1,
                            )))
                ),
            ],
            on_obstruction: ObstructionBehavior(
                on_ally: [
                    Discard,
                ],
                on_enemy: [
                    Capture,
                    Stop,
                ],
                on_empty: [
                    Capture,
                    Stop,
                ],
            ),
            on_capture: RemovePiece(OffsetFromOrigin((
                        -1,
                        0,
                    ))),
            generators: [
                Vector(
                    direction: (
                        -1,
                        -1,
                    ),
                    max_distance: Times(1),
                ),
            ],
            actions: [
                MoveSelf,
            ],
        ),
        // Right en passant on white
        MovementRule(
            conditions: [
                Equal(
                    SelfColor,
                    Color(White)
                ),
                Equal(
                    State(White("en_passant_target_square")),
                    Square(OffsetFromOrigin((
                                1,
                                -1,
                            )))
                ),
            ],
            on_obstruction: ObstructionBehavior(
                on_ally: [
                    Discard,
                ],
                on_enemy: [
                    Capture,
                    Stop,
                ],
                on_empty: [
                    Capture,
                    Stop,
                ],
            ),
            on_capture: RemovePiece(OffsetFromOrigin((
                        1,
                        0,
                    ))),
            generators: [
                Vector(
                    direction: (
                        1,
                        -1,
                    ),
                    max_distance: Times(1),
                ),
            ],
            actions: [
                MoveSelf,
            ],
        ),
        // Left en passant on black
        MovementRule(
            conditions: [
                Equal(
                    SelfColor,
                    Color(Black)
                ),
                Equal(
                    State(Black("en_passant_target_square")),
                    Square(OffsetFromOrigin((
                                -1,
                                1,
                            )))
                ),
            ],
            on_obstruction: ObstructionBehavior(
                on_ally: [
                    Discard,
                ],
                on_enemy: [
                    Capture,
                    Stop,
                ],
                on_empty: [
                    Capture,
                    Stop,
                ],
            ),
            on_capture: RemovePiece(OffsetFromOrigin((
                        -1,
                        0,
                    ))),
            generators: [
                Vector(
                    direction: (
                        -1,
                        1,
                    ),
                    max_distance: Times(1),
                ),
            ],
            actions: [
                MoveSelf,
            ],
        ),
        // Right en passant on black
        MovementRule(
            conditions: [
                Equal(
                    SelfColor,
                    Color(Black)
                ),
                Equal(
                    State(Black("en_passant_target_square")),
                    Square(OffsetFromOrigin((
                                1,
                                1,
                            )))
                ),
            ],
            on_obstruction: ObstructionBehavior(
                on_ally: [
                    Discard,
                ],
                on_enemy: [
                    Capture,
                    Stop,
                ],
                on_empty: [
                    Capture,
                    Stop,
                ],
            ),
            on_capture: RemovePiece(OffsetFromOrigin((
                        1,
                        0,
                    ))),
            generators: [
                Vector(
                    direction: (
                        1,
                        1,
                    ),
                    max_distance: Times(1),
                ),
            ],
            actions: [
                MoveSelf,
            ],
        ),
        // Side attacks on black
        MovementRule(
            conditions: [
                Equal(
                    SelfColor,
                    Color(Black)
                ),
                Not(IsEmpty(Square(Target))),
            ],
            on_obstruction: ObstructionBehavior(
                on_ally: [
                    Discard,
                ],
                on_enemy: [
                    Capture,
                    Stop,
                ],
                on_empty: [
                    Continue,
                ],
            ),
            on_capture: RemovePiece(Target),
            generators: [
                Vector(
                    direction: (
                        -1,
                        1,
                    ),
                    max_distance: Times(1),
                ),
                Vector(
                    direction: (
                        1,
                        1,
                    ),
                    max_distance: Times(1),
                ),
            ],
            actions: [
                MoveSelf,
            ],
        ),
        // Advance by 1 on white
        MovementRule(
            conditions: [
                Equal(
                    SelfColor,
                    Color(White)
                ),
            ],
            on_obstruction: ObstructionBehavior(
                on_ally: [
                    Discard,
                ],
                on_enemy: [
                    Discard,
                ],
                on_empty: [
                    Continue,
                ],
            ),
            on_capture: DoNothing,
            generators: [
                Vector(
                    direction: (
                        0,
                        -1,
                    ),
                    max_distance: Times(1),
                ),
            ],
            actions: [
                MoveSelf,
            ],
        ),
        // Advance by 1 on black
        MovementRule(
            conditions: [
                Equal(
                    SelfColor,
                    Color(Black)
                ),
            ],
            on_obstruction: ObstructionBehavior(
                on_ally: [
                    Discard,
                ],
                on_enemy: [
                    Discard,
                ],
                on_empty: [
                    Continue,
                ],
            ),
            on_capture: DoNothing,
            generators: [
                Vector(
                    direction: (
                        0,
                        1,
                    ),
                    max_distance: Times(1),
                ),
            ],
            actions: [
                MoveSelf,
            ],
        ),
        // Advance by 2 on white
        MovementRule(
            conditions: [
                Equal(
                    SelfColor,
                    Color(White)
                ),
                Equal(
                    OriginRow,
                    Row('2')
                ),
                IsEmpty(Square(OffsetFromOrigin((
                                0,
                                -1,
                            )))),
            ],
            on_obstruction: ObstructionBehavior(
                on_ally: [
                    Discard,
                ],
                on_enemy: [
                    Discard,
                ],
                on_empty: [
                    Continue,
                ],
            ),
            on_capture: DoNothing,
            generators: [
                Vector(
                    direction: (
                        0,
                        -2,
                    ),
                    max_distance: Times(1),
                ),
            ],
            actions: [
                MoveSelf,
                AddState(
                    name: Black("en_passant_target_square"),
                    value: Square(OffsetFromOrigin((
                                0,
                                -1,
                            ))),
                ),
                AddState(
                    name: Black("en_passant_capture_piece"),
                    value: Square(Target),
                ),
            ],
        ),
        // Advance by 2 on black
        MovementRule(
            conditions: [
                Equal(
                    SelfColor,
                    Color(Black)
                ),
                Equal(
                    OriginRow,
                    Row('7')
                ),
                IsEmpty(Square(OffsetFromOrigin((
                                0,
                                1,
                            )))),
            ],
            on_obstruction: ObstructionBehavior(
                on_ally: [
                    Discard,
                ],
                on_enemy: [
                    Discard,
                ],
                on_empty: [
                    Continue,
                ],
            ),
            on_capture: DoNothing,
            generators: [
                Vector(
                    direction: (
                        0,
                        2,
                    ),
                    max_distance: Times(1),
                ),
            ],
            actions: [
                MoveSelf,
                AddState(
                    name: White("en_passant_target_square"),
                    value: Square(OffsetFromOrigin((
                                0,
                                1,
                            ))),
                ),
                AddState(
                    name: White("en_passant_capture_piece"),
                    value: Square(Target),
                ),
            ],
        ),
    ],
    images: ChessPieceImages(
        white: "white_pawn.svg",
        black: "black_pawn.svg",
    ),
)
